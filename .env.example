# ─────────────────────────────────────────────────────────────────
# .env.example — shell-level variables for SAM CLI & AWS CLI
#
# Usage:
#   cp .env.example .env
#   source .env          # or: . .env
#   sam deploy           # or any other sam / aws command
#
# .env is git-ignored; never commit the real file.
# ─────────────────────────────────────────────────────────────────

# AWS credentials profile (matches a profile in ~/.aws/credentials)
# Leave blank to use the [default] profile.
export AWS_PROFILE=default

# Target region
export AWS_DEFAULT_REGION=us-east-1

# Your AWS account ID (used in some scripts / ARN construction)
export AWS_ACCOUNT_ID=123456789012

# ── Secrets (only needed if you update secrets via scripts) ───────
# These are the ACTUAL API keys that get uploaded to Secrets Manager.
# The Lambda functions retrieve them at runtime from Secrets Manager,
# so you don't need these for normal deploys — only for the one-time
# secret-update step (see scripts/update-secrets.sh if present).
export ZAVU_API_KEY=your-zavu-api-key-here
export OPENAI_API_KEY=your-openai-api-key-here
